# Modèle de configuration pour PYTHON-FLASK-SQLITE (à copier en .env à la racine du dépôt).
# Le fichier .env est lu par `flask --app main run` et `python main.py` (python-dotenv).

# Obligatoire : clé de signature des cookies de session. Générer une valeur longue et aléatoire :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Développement local uniquement (console de débogage + cookie non Secure). Ne jamais activer en production.
FLASK_DEBUG=0

# Cookie de session réservé à HTTPS. Par défaut : activé hors mode debug.
# Mettre 0 pour tester en HTTP local sans le mode debug.
# SESSION_COOKIE_SECURE=1

# Chemins des données (par défaut data/blog.db et data/uploads, non versionnés).
# DATABASE_PATH=data/blog.db
# UPLOAD_FOLDER=data/uploads

# Port de `python main.py` (défaut 8000).
# PORT=8000

# Mot de passe des comptes créés par scripts/seed_demo.py (défaut demo1234).
# DEMO_PASSWORD=
